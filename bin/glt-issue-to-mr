#!/usr/bin/env bash
# glt-issue-to-mr - turn small labelled issues into draft MRs.
#
#   glt-issue-to-mr [--issue IID ...] [--dry-run] [-v]
#
# Issues carrying GLT_ISSUE_LABEL (default "opencode") are implemented by the
# implementer agent on branch glt/issue-<iid> off the default branch, verified
# with GLT_VERIFY_CMD, pushed, and opened as a Draft MR that closes the issue.
# The trigger label is swapped for GLT_ISSUE_DONE_LABEL (or _FAIL_LABEL), so a
# human controls exactly which issues cost tokens, and each is attempted once.
set -euo pipefail
SCRIPT_NAME="issue-to-mr"
# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"

: "${GLT_ISSUE_LABEL:=opencode}"
: "${GLT_ISSUE_DONE_LABEL:=opencode::mr-created}"
: "${GLT_ISSUE_FAIL_LABEL:=opencode::needs-human}"
: "${GLT_ISSUE_MAX_PER_RUN:=2}"
: "${GLT_ISSUE_DESC_MAX:=6000}"
: "${GLT_ISSUE_BRANCH_PREFIX:=glt/issue-}"
: "${GLT_MR_LABELS:=opencode-generated}"

ONLY=()
while (( $# )); do
  case "$1" in
    --issue) ONLY+=("$2"); shift 2 ;;
    --dry-run) GLT_DRY_RUN=1; shift ;;
    -v|--verbose) GLT_VERBOSE=1; shift ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
require_cmd glab git jq flock
acquire_lock issue-to-mr
ensure_repo
DIR="$(repo_dir)"
DEFAULT_BRANCH="$(gl_api GET "projects/:id" | jq -r .default_branch)"

issues() {
  if (( ${#ONLY[@]} )); then local i; for i in "${ONLY[@]}"; do gl_api GET "projects/:id/issues/$i" | jq -c '{iid, title, description, web_url, labels}'; done
  else gl_api_paginated "projects/:id/issues?state=opened&labels=$(printf '%s' "$GLT_ISSUE_LABEL" | jq -sRr @uri)&per_page=50" | jq -c '.[] | {iid, title, description, web_url, labels}'; fi
}
relabel() { gl_api PUT "projects/:id/issues/$1" -f "add_labels=$2" -f "remove_labels=$GLT_ISSUE_LABEL" >/dev/null; }

handle_issue() {
  local is="$1" iid title url branch
  iid="$(jq -r .iid <<<"$is")"; title="$(jq -r .title <<<"$is")"; url="$(jq -r .web_url <<<"$is")"; branch="$GLT_ISSUE_BRANCH_PREFIX$iid"
  state_has issues.seen "$iid" && { dbg "#$iid already attempted"; return; }
  if git -C "$DIR" rev-parse -q --verify "origin/$branch" >/dev/null; then warn "#$iid: origin/$branch exists; skipping"; state_add issues.seen "$iid"; return; fi
  budget_ok || { warn "budget exhausted; #$iid deferred"; return; }
  log "#$iid '$title': implementing on $branch"
  state_add issues.seen "$iid"
  git -C "$DIR" checkout -q -B "$branch" "origin/$DEFAULT_BRANCH"

  local pf="$GLT_LOG_DIR/prompt.issue.$iid.md" out
  { echo "Implement GitLab issue #$iid: $title"; echo; echo "Description:"; jq -r '.description // "(none)"' <<<"$is" | head -c "$GLT_ISSUE_DESC_MAX"; echo; } > "$pf"
  if ! out="$(oc_run glt-implementer "$DIR" "$pf")" || grep -q '^ESCALATE:' <<<"$out" || [[ -z "$(git -C "$DIR" status --porcelain)" ]]; then
    git -C "$DIR" reset -q --hard; git -C "$DIR" clean -qfd
    relabel "$iid" "$GLT_ISSUE_FAIL_LABEL"
    { echo "Issue: $url"; echo "The implementer made no usable change."; echo; echo "$out"; } | send_mail "#$iid needs a human"
    return
  fi
  if ! run_verify; then
    git -C "$DIR" reset -q --hard; git -C "$DIR" clean -qfd; relabel "$iid" "$GLT_ISSUE_FAIL_LABEL"
    { echo "Issue: $url"; echo "Implemented but GLT_VERIFY_CMD failed; branch discarded."; echo; echo "$out"; echo; tail -80 "$GLT_LOG_DIR/verify.last.log"; } | send_mail "#$iid implementation failed verification"
    return
  fi
  git -C "$DIR" add -A
  git -C "$DIR" commit -q -m "$(head -c 70 <<<"$title")" -m "Closes #$iid" -m "Automated first draft with opencode via gitlab-tools."
  git_push -u "$branch"
  local desc; desc="$(printf 'Closes #%s\n\n%s\n\n---\n_Draft generated by opencode (gitlab-tools). Review carefully._' "$iid" "$out")"
  local mr; mr="$(gl_api POST "projects/:id/merge_requests" -f "source_branch=$branch" -f "target_branch=$DEFAULT_BRANCH" \
        -f "title=Draft: $title" -f "description=$desc" -f "labels=$GLT_MR_LABELS" -F remove_source_branch=true)"
  local mr_url; mr_url="$(jq -r '.web_url // "(dry-run)"' <<<"$mr")"
  relabel "$iid" "$GLT_ISSUE_DONE_LABEL"
  log "#$iid -> $mr_url"
  { echo "Issue: $url"; echo "Draft MR: $mr_url"; echo; echo "$out"; } | send_mail "#$iid: draft MR created"
}

n=0
while IFS= read -r is; do
  [[ -z "$is" ]] && continue
  (( n < GLT_ISSUE_MAX_PER_RUN )) || break
  n=$(( n + 1 )); handle_issue "$is"
done < <(issues)
log "done; issues=$n tokens=$TOKENS_USED"
