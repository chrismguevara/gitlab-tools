# gitlab-tools configuration. Copy to ~/.config/gitlab-tools/env (chmod 600).
# Every variable can also be set in the crontab environment.

# --- GitLab -----------------------------------------------------------------
GLT_PROJECT="group/project"            # path of the project the scripts watch
GITLAB_HOST="gitlab.com"               # self-managed: your hostname
GITLAB_TOKEN="glpat-..."               # api + write_repository scopes (or run `glab auth login` as the cron user)
GLT_GIT_REMOTE=""                      # optional explicit clone URL; default: ssh_url_to_repo from the API
GLT_MR_LIST_ARGS="--author=@me"        # which MRs are "ours" (any `glab mr list` filter, e.g. --label=bot-managed)
GLT_SKIP_DRAFTS=1

# --- Behaviour --------------------------------------------------------------
GLT_VERIFY_CMD=""                      # e.g. "make test" - must pass before anything is pushed
GLT_REBASE_CONFLICT_MODE="plan"        # mail | plan | resolve
GLT_REBASE_SKIP_LABEL="no-auto-rebase"
GLT_COMMENTS_HEURISTIC_ONLY=0          # 1 = classify with regexes only, never call the model
GLT_AUTO_RESOLVE=0                     # resolve threads after an automatic fix
GLT_CI_AUTOFIX=0                       # let the fixer try lint/build failures
GLT_ISSUE_LABEL="opencode"             # issues with this label get a draft MR
GLT_DIGEST_LLM=0

# --- Mail ---------------------------------------------------------------------
GLT_MAIL_TO="$USER"                    # local unix mailbox, or an address your MTA relays
# GLT_MAIL_CMD='mail -s'               # override: invoked as $GLT_MAIL_CMD "subject" "to" with body on stdin

# --- opencode ---------------------------------------------------------------------
GLT_OPENCODE_BIN="opencode"
# GLT_OPENCODE_CONFIG="/path/to/gitlab-tools/opencode/opencode.json"
GLT_OPENCODE_TIMEOUT=900               # seconds per opencode invocation
GLT_MAX_TOKENS_PER_RUN=400000          # soft budget; LLM work stops for the rest of the run once exceeded
# Provider credentials for cron (pick what your opencode.json model uses):
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."

# --- Paths ------------------------------------------------------------------------
GLT_WORKDIR="$HOME/.cache/gitlab-tools"            # clones
GLT_STATE_DIR="$HOME/.local/state/gitlab-tools"    # idempotency state, logs, mail outbox
