{
  "$schema": "https://opencode.ai/config.json",

  "model": "anthropic/claude-sonnet-5-5",
  "small_model": "anthropic/claude-haiku-5-5",

  "share": "disabled",
  "autoupdate": false,

  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny"
  },

  "agent": {
    "glt-classifier": {
      "description": "Classifies MR review comments into minor_fix / substantial / question / no_action. No tools.",
      "mode": "primary",
      "model": "anthropic/claude-haiku-5-5",
      "temperature": 0,
      "prompt": "{file:./prompts/classifier.md}",
      "tools": {
        "bash": false, "read": false, "write": false, "edit": false, "glob": false, "grep": false,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      }
    },

    "glt-summarizer": {
      "description": "Turns structured logs/diffs into a short root-cause or digest summary. No tools.",
      "mode": "primary",
      "model": "anthropic/claude-haiku-5-5",
      "temperature": 0,
      "prompt": "{file:./prompts/summarizer.md}",
      "tools": {
        "bash": false, "read": false, "write": false, "edit": false, "glob": false, "grep": false,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      }
    },

    "glt-planner": {
      "description": "Read-only. Writes a conflict-resolution or change plan for a human.",
      "mode": "primary",
      "temperature": 0,
      "prompt": "{file:./prompts/planner.md}",
      "tools": {
        "read": true, "glob": true, "grep": true,
        "bash": false, "write": false, "edit": false,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      },
      "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny" }
    },

    "glt-resolver": {
      "description": "Resolves git rebase conflicts by editing the conflicted files only. No shell.",
      "mode": "primary",
      "temperature": 0,
      "prompt": "{file:./prompts/resolver.md}",
      "tools": {
        "read": true, "glob": true, "grep": true, "edit": true, "write": true,
        "bash": false,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      },
      "permission": { "edit": "allow", "bash": "deny", "webfetch": "deny" }
    },

    "glt-fixer": {
      "description": "Applies one small, well-specified code change (review nit, lint fix). Read-only git only.",
      "mode": "primary",
      "temperature": 0,
      "prompt": "{file:./prompts/fixer.md}",
      "tools": {
        "read": true, "glob": true, "grep": true, "edit": true, "write": true, "bash": true,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      },
      "permission": {
        "edit": "allow",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow"
        }
      }
    },

    "glt-implementer": {
      "description": "Implements a small, labelled issue on a fresh branch. Edits + read-only git.",
      "mode": "primary",
      "temperature": 0,
      "prompt": "{file:./prompts/implementer.md}",
      "tools": {
        "read": true, "glob": true, "grep": true, "edit": true, "write": true, "bash": true,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      },
      "permission": {
        "edit": "allow",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "ls*": "allow"
        }
      }
    },

    "glt-reviewer": {
      "description": "Optional subagent: reviews a diff for bugs and returns a short bullet list. Read-only.",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-5-5",
      "temperature": 0,
      "prompt": "{file:./prompts/reviewer.md}",
      "tools": {
        "read": true, "glob": true, "grep": true,
        "bash": false, "write": false, "edit": false,
        "webfetch": false, "websearch": false, "task": false, "todowrite": false, "skill": false, "lsp": false
      },
      "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny" }
    }
  }
}
